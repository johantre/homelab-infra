# dnsmasq config — NanoPi Router
# Manages DHCP for LAN (.3.0/24) and Modbus (.4.0/24)

# Listen on internal interfaces only
interface={{ nanopirouter_lan_interface }}
interface={{ nanopirouter_modbus_interface }}
bind-interfaces
except-interface=lo

# DNS upstream → PiHole
server={{ nanopirouter_dns_server }}
no-resolv

# Local domain
domain=local
local=/local/

# ============================================================
# LAN DHCP (192.168.3.0/24)
# Tag: lan
# ============================================================
dhcp-range=set:lan,{{ nanopirouter_lan_dhcp_start }},{{ nanopirouter_lan_dhcp_end }},{{ nanopirouter_lan_dhcp_lease }}
dhcp-option=tag:lan,option:router,{{ nanopirouter_lan_ip }}
dhcp-option=tag:lan,option:dns-server,{{ nanopirouter_dns_server }}

# DHCP reservations LAN
{% for host in nanopirouter_dhcp_reservations %}
dhcp-host={{ host.mac }},{{ host.ip }},{{ host.name }}
{% endfor %}

# ============================================================
# MODBUS DHCP (192.168.4.0/24)
# Tag: modbus — router itself handles DNS for Modbus segment
# ============================================================
dhcp-range=set:modbus,{{ nanopirouter_modbus_dhcp_start }},{{ nanopirouter_modbus_dhcp_end }},12h
dhcp-option=tag:modbus,option:router,{{ nanopirouter_modbus_ip }}
dhcp-option=tag:modbus,option:dns-server,{{ nanopirouter_modbus_ip }}

# Fixed IPs Modbus devices
{% for host in nanopirouter_modbus_hosts %}
dhcp-host={{ host.mac }},{{ host.ip }},{{ host.name }}
{% endfor %}

# Logging
log-dhcp
